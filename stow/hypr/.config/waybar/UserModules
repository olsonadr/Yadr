/* Waybar Modules Extras */

/* This is where you can add Extra Modules you wish. copy.sh will try to restore*/
/* this file along with the unique configs and styles. */
/* IMPORTANT, be mindful with , or ". else waybar will not start */

{
  "group/audio_no_drawer": {
	"orientation": "inherit",
	"modules": [
		"pulseaudio",
	]
  },
  "group/notify_no_drawer": {
        "orientation": "inherit",
        "modules": [
                "custom/swaync",
        ]
  },
  "group/mobo_no_drawer": {
	"orientation": "inherit",
	"modules": [
		"temperature",
		"cpu",
		"memory",
		"disk",
	]
  },
  "group/audio_no_drawer": {
	"orientation": "inherit",
	"modules": [
		"pulseaudio",
		"pulseaudio#microphone",
	]
  },
  "custom/my_power_profile_text": {
    "format": "{}",
    "exec": "powerprofilesctl get",
    "interval": "once",
    "exec-on-event": "sleep 0.5 && powerprofilesctl get",
	"on-click": "$HOME/.local/bin/cycle_power"
  },
  "custom/my_power_profile": {
    "format": "{icon}",
    "format-icons": {
      "default": "... ",
      "performance": " ",
      "balanced": " ",
      "power-saver": " "
    },
    "exec": "sleep 0.7 && echo $(JSON=true BLOCK=true $HOME/.local/bin/get_power_profile)",
	"on-click": "JSON=true $HOME/.local/bin/cycle_power >/dev/null",
    "return-type": "json",
    "exec-on-event": "true",
    "interval": "once"
  },
  "group/battery_and_profile": {
	"orientation": "inherit",
	"modules": [
	        // "custom/my_power_profile",
                "power-profiles-daemon",
		"battery",
	]
  }
}
