// ### Mine (based on "TOP Simple") ### //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/UserModules"
  ],
"layer": "top", 
"position": "top", 
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"margin-left": 0,
"margin-right": 0,
"margin-top": 0,
"margin-bottom": 0,

"modules-left": [ 
	"tray",
	"hyprland/workspaces#rw",
	"hyprland/window",  
	"mpris" 
	],
    
"modules-center": [
	"clock#2",
	"group/notify_no_drawer",
	"idle_inhibitor"
	],
    
"modules-right": [
//        "power-profiles-daemon",
        "group/mobo_no_drawer",
	"group/battery_and_profile",
        "group/audio_no_drawer", 
	"custom/power"
	]
}

