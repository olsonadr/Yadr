" ~/.vimrc_common - loader shared by vim and nvim (g:vimdist = 'vim' | 'nvim').
" Sources ~/.vimrc.d/common.d/*.vim and ~/.vimrc.d/<g:vimdist>.d/*.vim, merged and
" ordered by file BASENAME. Any stow package may add files there.
" Files starting with "_" or ending in .bak/.disabled/.off/~ are skipped.
let s:root = $HOME . '/.vimrc.d'
let s:files = glob(s:root . '/common.d/*.vim', 0, 1) + glob(s:root . '/' . g:vimdist . '.d/*.vim', 0, 1)
call filter(s:files, 'fnamemodify(v:val, ":t") !~# "^_"')
call sort(s:files, {a, b -> fnamemodify(a, ':t') ==# fnamemodify(b, ':t') ? 0 : fnamemodify(a, ':t') ># fnamemodify(b, ':t') ? 1 : -1})
for s:f in s:files
  if exists('$VIMRC_D_DEBUG') | echom 'vimrc.d: ' . s:f | endif
  execute 'source' fnameescape(s:f)
endfor
" vim: set ts=8 sw=4 tw=78 et :
