"Plugin-related config"

"-------------"
" Plugin Maps "
"-------------"
" Easymotion
map <Leader> <Plug>(easymotion-prefix)
map <Leader><CR> <Plug>(easymotion-jumptoanywhere)
map <Leader><Leader>j <Plug>(easymotion-jumptoanywhere)
" NERDTree
map <C-\> :NERDTreeToggle<CR>
map <Leader>s <Plug>(leap-anywhere)
if g:vimdist == "vim"
    "" vim specific plugin maps
elseif g:vimdist == "nvim"
    "" nvim specific plugins maps
    " Leap
    map s <Plug>(leap)
    map S <Plug>(leap)
    "nmap s <Plug>(leap)
    "xmap s <Plug>(leap)
    "omap s <Plug>(leap)
    "nmap S <Plug>(leap-from-window)
    "nmap S <Plug>(leap-anywhere)
endif

"-----------------------------"
" Vundle Settings/Plugin List "
"-----------------------------"
let &rtp .= ','.$HOME.'/.'.g:vimdist.'/bundle/Vundle.vim'
filetype off
call vundle#begin()
let g:vundle#bundle_dir = $HOME.'/.'.g:vimdist.'/bundle/'
" vimdist-agnostic plugins
Plugin 'VundleVim/Vundle.vim'
Plugin 'bullets-vim/bullets.vim'
Plugin 'ctrlpvim/ctrlp.vim'
Plugin 'drewtempelmeyer/palenight.vim'
Plugin 'easymotion/vim-easymotion'
"Plugin 'inkarkat/vim-camelcasemotion'
Plugin 'junegunn/fzf'
Plugin 'junegunn/fzf.vim'
Plugin 'mhinz/vim-startify'
Plugin 'rdnetto/YCM-Generator'
Plugin 'scrooloose/nerdcommenter'
Plugin 'scrooloose/nerdtree'
Plugin 'tpope/vim-repeat'
Plugin 'tpope/vim-surround'
"Plugin 'Valloric/YouCompleteMe'
if g:vimdist == "vim"
    " vim specific plugins
    Plugin 'ap/vim-buftabline'
    "Plugin 'bling/vim-bufferline'
    Plugin 'justinmk/vim-sneak'
elseif g:vimdist == "nvim"
    " nvim specific plugins
    Plugin 'akinsho/bufferline.nvim'
    Plugin 'folke/tokyonight.nvim'
    Plugin 'folke/which-key.nvim'
    Plugin 'ggandor/leap.nvim'
    Plugin 'shrynx/line-numbers.nvim'
    Plugin 'neovim/nvim-lspconfig'
    Plugin 'nvim-treesitter/nvim-treesitter'
    Plugin 'octol/vim-cpp-enhanced-highlight'
endif

call vundle#end()
filetype plugin indent on
let g:ycm_global_ycm_extra_conf = $HOME.'/.'.g:vimdist.'/.ycm_extra_conf.py'
let g:ycm_server_keep_logfiles = 1
let g:ycm_server_log_level = 'debug'

"----------------------------"
" Plugin Settings (non-maps) "
"----------------------------"
" Ctrl-P Settings
let runtimepath = $HOME.'/.'.g:vimdist.'/bundle/ctrlp.vim'
set tags+=doc/tags
let g:ctrlp_working_path_mode = 'ra'
let g:ctrlp_extensions = ['buffertag', 'dir', 'line']
let g:ctrlp_show_hidden=1
" Startify stuff
function s:my_sessions()
    let s_files = split(globpath('./doc/sessions', '*'), '\n')
    return map(s_files, '{"line": v:val, "cmd": "source". v:val }')
endfunction
let g:startify_lists = [
	    \ { 'header': ['   Doc Sessions'],	'type': function('s:my_sessions') },
	    \ { 'type': 'files',	'header': ['   MRU']            },
	    \ { 'type': 'dir',		'header': ['   MRU '. getcwd()] },
	    \ { 'type': 'sessions',	'header': ['   Sessions']       },
	    \ { 'type': 'bookmarks',	'header': ['   Bookmarks']      },
	    \ { 'type': 'commands',	'header': ['   Commands']       },
	    \ ]
" Bufferline Settings
let g:bufferline_solo_highlight = 0
let g:bufferline_always_show_bufferline = 1

