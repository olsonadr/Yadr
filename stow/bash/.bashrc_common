# ~/.bashrc_common: rc common to ".{ba,z}shrc"

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

## User defined definitions

# PATH modifications
export PATH="/usr/share/Modules/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:${PATH}"
export PATH="${HOME}/.vimpkg/bin:${PATH}"
export PATH="${HOME}/.local/bin:${PATH}"
export PATH="${HOME}/.cargo/bin:${PATH}"
export PATH="${HOME}/bin:${PATH}"
export PATH="/snap/bin:${PATH}"
export PATH="${HOME}/.local/share/bob/nvim-bin:${PATH}"
export PATH="${HOME}/go/bin:${PATH}"
export PATH="${HOME}/Documents/flutter/flutter/bin:${PATH}"
export PATH="${HOME}/.opencode/bin:${PATH}"

#export PATH="${PATH}:/usr/local/bin/JLink_Linux_V794e_x86_64"

# Common secrets
if [ -f "$HOME/.bashrc_secrets" ]; then
	. "$HOME/.bashrc_secrets"
fi

# Common aliases
if [ -f "$HOME/.bash_aliases_common" ]; then
	. "$HOME/.bash_aliases_common"
fi

## Misc

XAUTHORITY=$HOME/.Xauthority

## Fix keyboard layout
#setxkbmap -option

[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env" # ghcup-env
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env" # cargo-env

# Pyenv configuration (only if pyenv is installed).
# Only the shell agnostic part lives here: PYENV_ROOT and the shim PATH entry.
# The "pyenv init" call is shell specific and is done in ~/.bashrc and
# ~/.zshrc, right after this file is sourced.
if [ -d "$HOME/.pyenv" ]; then
	export PYENV_ROOT="$HOME/.pyenv"
	[ -d "$PYENV_ROOT/bin" ] && export PATH="$PYENV_ROOT/bin:$PATH"
fi

## Setup brew env
# "brew shellenv" needs different handling per shell (under zsh its fpath
# lines must be filtered out), so it is done in ~/.bashrc and ~/.zshrc.

## local-open setup for windows host
#LOCAL_OPEN_

### Setup Instant History Across Terminals
### Source: https://unix.stackexchange.com/a/1292
## Avoid duplicates
#HISTCONTROL=ignoredups:erasedups
## When the shell exits, append to the history file instead of overwriting it
#shopt -s histappend
## After each command, append to the history file and reread it
#PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a; history -c; history -r"

## Setup kmk user
export KMK_USER="r1020325"

## Android SDK location
export ANDROID_HOME=~/Android/Sdk

## Source dark evil file if it exists
[[ -e "${HOME}/.bashrc_secrets" ]] && . "$HOME/.bashrc_secrets"

[[ -e "${HOME}/lib/oracle-cli/lib/python3.12/site-packages/oci_cli/bin/oci_autocomplete.sh" ]] && source "${HOME}/lib/oracle-cli/lib/python3.12/site-packages/oci_cli/bin/oci_autocomplete.sh"
[[ -d /usr/local/go/bin ]] && export PATH="$PATH:/usr/local/go/bin"

# NOTE: pyenv is already initialised above (see the PYENV_ROOT block). It used to
# be initialised a second time here, which forked another "pyenv init" subshell
# and re-scanned every PATH directory on each shell start for no benefit.
# The duplicate "export PATH=${HOME}/bin:${PATH}" that lived here was also
# dropped: ${HOME}/bin does not exist and was already added earlier.

# NOTE: PATH deduplication used to live here behind a "$ZSH_VERSION" test. The
# zsh branch used array assignment and a glob qualifier, which bash cannot even
# parse, so the whole file had to be kept parseable by both shells. The logic
# now lives at the end of ~/.bashrc and ~/.zshrc instead.
