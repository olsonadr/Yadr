# ~/.bashrc_common: rc common to ".{ba,z}shrc"

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

## User defined definitions

# PATH modifications
export PATH="/usr/share/Modules/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin"
export PATH="${HOME}/.vimpkg/bin:${PATH}"
export PATH="${HOME}/.local/bin:${PATH}"
export PATH="${HOME}/.cargo/bin:${PATH}"
export PATH="${HOME}/bin:${PATH}"
export PATH="/snap/bin:${PATH}"
export PATH="${HOME}/.local/share/bob/nvim-bin:${PATH}"
export PATH="${HOME}/go/bin:${PATH}"
export PATH="${HOME}/Documents/flutter/flutter/bin:${PATH}"

#export PATH="${PATH}:/usr/local/bin/JLink_Linux_V794e_x86_64"

# Common secrets
if [ -f "$HOME/.bashrc_secrets" ]; then
	. "$HOME/.bashrc_secrets"
fi

# Common aliases
if [ -f "$HOME/.bash_aliases_common" ]; then
	. "$HOME/.bash_aliases_common"
fi

## Misc

XAUTHORITY=$HOME/.Xauthority

## Fix keyboard layout
#setxkbmap -option

[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env" # ghcup-env
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env" # cargo-env

# Pyenv configuration (only if pyenv is installed)
#if command -v pyenv 1>/dev/null 2>&1; then
if [[ -d "$HOME/.pyenv" ]]; then
	export PYENV_ROOT="$HOME/.pyenv"
	[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
	eval "$(pyenv init - bash)"
fi

## Setup brew env
if [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

## local-open setup for windows host
#LOCAL_OPEN_

